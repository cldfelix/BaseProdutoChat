        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const dados = $input.first().json.output ?? {};\nconst registro = {\n  fornecedor: dados.fornecedor ?? null,\n  cnpj: dados.cnpj ?? null,\n  numero_nota: dados.numero_nota ?? null,\n  data_emissao: dados.data_emissao ?? null,\n  valor_total: dados.valor_total ?? null,\n  impostos: dados.impostos ?? null,\n  moeda: dados.moeda ?? 'BRL',\n  processado_em: new Date().toISOString(),\n};\nreturn [{ json: { ...registro, linha: JSON.stringify(registro) + '\\n' } }];"
