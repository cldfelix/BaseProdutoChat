    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = $input.all().map((i) => i.json).filter((r) => r && r.valor);\nlet total = 0;\nconst porRegiao = {};\nconst porProduto = {};\nfor (const r of rows) {\n  const v = Number(r.valor) || 0;\n  total += v;\n  porRegiao[r.regiao] = Number(((porRegiao[r.regiao] || 0) + v).toFixed(2));\n  porProduto[r.produto] = Number(((porProduto[r.produto] || 0) + v).toFixed(2));\n}\nconst topProdutos = Object.entries(porProduto)\n  .sort((a, b) => b[1] - a[1])\n  .slice(0, 5)\n  .map(([produto, valor]) => ({ produto, valor }));\nreturn [{ json: {\n  quantidade_pedidos: rows.length,\n  total_vendas: Number(total.toFixed(2)),\n  ticket_medio: Number((total / (rows.length || 1)).toFixed(2)),\n  por_regiao: porRegiao,\n  top_produtos: topProdutos,\n  periodo: `${rows[0]?.data ?? ''} a ${rows[rows.length - 1]?.data ?? ''}`,\n} }];"
      },
      "id": "36be6304-4613-5ba7-adb8-7ede6193157c",
      "name": "Agregar indicadores",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Você é um analista de vendas. Com base nos indicadores abaixo, escreva um resumo executivo em português do Brasil com:\n1) destaque do período; 2) leitura dos números; 3) 2 recomendações práticas.\nUse no máximo 12 linhas e não invente dados.\n\nIndicadores (JSON):\n{{ JSON.stringify($json) }}",
        "hasOutputParser": false
      },
