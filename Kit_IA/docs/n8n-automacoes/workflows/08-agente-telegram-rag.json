        260
      ],
      "credentials": {
        "ollamaApi": {
          "id": "xHuYe0MDGOs9IpBW",
          "name": "Local Ollama service"
        }
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $json.message.chat.id }}",
        "contextWindowLength": 12
      },
      "id": "44d65e62-a5f7-5d92-a00c-689107cb88a5",
      "name": "Memória por chat",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4,
      "position": [
        280,
        430
      ]
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "qdrantCollection": {
          "__rl": true,
          "mode": "id",
          "value": "documentos"
        },
        "toolName": "buscar_documentos",
        "toolDescription": "Busca trechos relevantes na base de conhecimento interna.",
        "topK": 4,
        "includeDocumentMetadata": true
