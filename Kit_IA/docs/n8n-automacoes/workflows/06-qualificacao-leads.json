        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const form = $('Form: lead').first().json;\nconst ia = $input.first().json.output ?? {};\nconst lead = {\n  nome: form.nome ?? null,\n  email: form.email ?? null,\n  empresa: form.empresa ?? null,\n  orcamento: form.orcamento ?? null,\n  mensagem: form.mensagem ?? null,\n  score: Number(ia.score ?? 0),\n  classificacao: ia.classificacao ?? 'indefinido',\n  resumo: ia.resumo ?? '',\n  proximo_passo: ia.proximo_passo ?? '',\n  recebido_em: new Date().toISOString(),\n};\nreturn [{ json: { ...lead, linha: JSON.stringify(lead) + '\\n' } }];"
      },
